{
  "compilerOptions": {
    "module": "Node16",
    "moduleResolution": "Node16",
    "target": "ES2022",
    "lib": ["ES2022"],
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "types": ["node", "vscode"],
    "paths": {
      "ai-stack-kit-core": ["../dist/index.js"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "webview-ui"]
}
