{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build-core",
      "type": "shell",
      "command": "npm run build",
      "options": { "cwd": "${workspaceFolder}/.." },
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "extension-package",
      "type": "shell",
      "command": "npm run package",
      "options": { "cwd": "${workspaceFolder}" },
      "dependsOn": ["build-core"],
      "problemMatcher": ["$esbuild"]
    },
    {
      "label": "npm: compile",
      "dependsOn": ["extension-package"],
      "group": { "kind": "build", "isDefault": true }
    }
  ]
}
